POSTGRES_DB=croesus
POSTGRES_USER=croesus
POSTGRES_PASSWORD=

# Optional: set both to require login (needed for remote desktop mode to
# connect to this instance). Leave unset to keep the API open, as today.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Required if ADMIN_USERNAME/ADMIN_PASSWORD or any OIDC_* var below is set —
# any long random string, kept secret.
# JWT_SECRET=

# Optional: Generic OIDC SSO (Authentik, Keycloak, or any other
# OIDC-compliant provider). Independent of ADMIN_USERNAME/ADMIN_PASSWORD
# above — use one, the other, or both. Whoever your IdP lets sign in to
# this client is trusted; Croesus doesn't do its own allow-listing on top.
# OIDC_ISSUER=https://idp.example.com/application/o/croesus/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Must be this backend's own public URL + /auth/oidc/callback, and
# registered as the redirect URI in your IdP's client config.
# OIDC_REDIRECT_URI=https://api.example.com/auth/oidc/callback
# Shown on the login button as "Sign in with <name>". Defaults to "SSO".
# OIDC_DISPLAY_NAME=Authentik

# Defaults to ["http://localhost:8080"] (see docker-compose.yml). If you'll
# use the desktop app's remote mode against this instance, this needs
# "tauri://localhost" and "http://tauri.localhost" too — running
# scripts/prod-setup.sh sets this for you.
# CORS_ORIGINS=["https://your-frontend-origin","tauri://localhost","http://tauri.localhost"]
