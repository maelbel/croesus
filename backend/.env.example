# SQLite (local desktop mode): sqlite:///./croesus.db
# PostgreSQL (self-hosted): postgresql+psycopg://user:password@postgres:5432/croesus
DATABASE_URL=sqlite:///./croesus.db

CORS_ORIGINS=["http://localhost:5173","tauri://localhost","http://tauri.localhost"]

# Optional: set both to require login (needed for remote desktop mode to
# connect to this instance). Leave unset to keep the API open, as today.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Required if the two above are set — any long random string, kept secret.
# JWT_SECRET=

# Automatic price fetching for assets with a symbol set (stocks/ETFs via
# Yahoo Finance's unofficial endpoint, crypto via CoinGecko — both keyless).
# Optional: set to false to disable the background refresh entirely.
# PRICE_REFRESH_ENABLED=true
# Optional: how often to refresh, in minutes.
# PRICE_REFRESH_INTERVAL_MINUTES=360
# Optional: how long a fetched price is reused before hitting the external
# API again for that symbol.
# PRICE_CACHE_TTL_MINUTES=5

# Multi-currency: each account/liability has its own currency; this is only
# the deployment-wide default reference currency for the consolidated net
# worth view when a request doesn't explicitly ask for another one.
# REFERENCE_CURRENCY=EUR
# Optional: how long a fetched exchange rate (from Frankfurter, keyless) is
# reused before hitting the external API again for that currency pair.
# FX_RATE_CACHE_TTL_MINUTES=720

# Periodically checks GitHub for a newer Croesus release, shown as an
# "update available" indicator in Settings -> About.
# Optional: set to false to disable (e.g. an air-gapped self-hosted instance).
# UPDATE_CHECK_ENABLED=true
# Optional: how long a fetched release check is reused before hitting the
# GitHub API again.
# UPDATE_CHECK_CACHE_TTL_MINUTES=720
